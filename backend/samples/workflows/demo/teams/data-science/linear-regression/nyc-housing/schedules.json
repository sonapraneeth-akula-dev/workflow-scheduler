{
  "$schema": "../../../../../../../src/Wf.Contracts/Schemas/schedules.schema.json",
  "defaults": {
    "experiment": {
      "experimentNumber": 1,
      "trainingPercent": 70,
      "validationPercent": 15,
      "testPercent": 15,
      "learningRate": 0.1,
      "forceDownload": false
    }
  },
  "instances": [
    {
      "id": "daily-training-validation",
      "name": "Training & validation",
      "cron": "0 */4 * * *",
      "timezone": "Etc/UTC",
      "overlap": "Skip",
      "catchUp": "Latest",
      "variables": {
        "runFinalTest": false,
        "epochs": 50
      }
    },
    {
      "id": "daily-full-test",
      "name": "Full test",
      "cron": "0 2-23/4 * * *",
      "timezone": "Etc/UTC",
      "overlap": "Skip",
      "catchUp": "Latest",
      "variables": {
        "experimentNumber": 2,
        "runFinalTest": true,
        "epochs": 100
      }
    }
  ],
  "historyCards": [
    {
      "id": "training-validation",
      "name": "Training & validation",
      "visible": true,
      "scheduleIds": ["daily-training-validation"]
    },
    {
      "id": "full-test",
      "name": "Full test",
      "visible": true,
      "scheduleIds": ["daily-full-test"]
    }
  ]
}

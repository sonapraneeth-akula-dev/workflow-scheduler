{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kardia team registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["team", "types"],
  "properties": {
    "$schema": { "type": ["string", "null"] },
    "team": { "$ref": "#/$defs/identifier" },
    "deployment": { "type": "string", "enum": ["Demo", "Production"], "default": "Production" },
    "types": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflowType" }
    },
    "roleBindings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/roleBinding" }
    },
    "presentation": { "$ref": "#/$defs/presentation" }
  },
  "$defs": {
    "presentation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [],
      "properties": {
        "typeOrder": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonemptyText" }
        },
        "groupingKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonemptyText" }
        },
        "listColumns": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonemptyText" }
        },
        "defaultFilters": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/nonemptyText" },
          "additionalProperties": { "$ref": "#/$defs/nonemptyText" }
        },
        "labels": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/nonemptyText" },
          "additionalProperties": { "$ref": "#/$defs/nonemptyText" }
        },
        "names": {
          "type": "object",
          "description": "Display names keyed by exact resource ID or grouping value. Does not rename identifiers.",
          "propertyNames": { "$ref": "#/$defs/displayName" },
          "additionalProperties": { "$ref": "#/$defs/displayName" }
        }
      }
    },
    "nonemptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "identifier": {
      "allOf": [{ "$ref": "#/$defs/nonemptyText" }],
      "maxLength": 128,
      "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "displayName": {
      "allOf": [{ "$ref": "#/$defs/nonemptyText" }],
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "workflowType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "name", "description", "metadataSchema"],
      "properties": {
        "team": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/identifier" },
        "description": { "$ref": "#/$defs/nonemptyText" },
        "metadataSchema": { "$ref": "#/$defs/metadataSchema" },
        "roleBindings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/roleBinding" }
        }
      }
    },
    "metadataSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "properties": {
        "keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/metadataField" }
        },
        "allowFreeForm": { "type": "boolean", "default": false }
      }
    },
    "metadataField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "$ref": "#/$defs/nonemptyText" },
        "required": { "type": "boolean", "default": false },
        "allowedValues": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonemptyText" }
        }
      }
    },
    "roleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "groupId"],
      "properties": {
        "role": { "type": "string", "enum": ["Viewer", "Operator", "Author", "Admin"] },
        "groupId": {
          "type": "string",
          "format": "uuid",
          "not": { "const": "00000000-0000-0000-0000-000000000000" }
        }
      }
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="dbup-postgresql" />
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" />
    <ProjectReference Include="..\Wf.Contracts\Wf.Contracts.csproj" />
    <ProjectReference Include="..\Wf.Engine.Core\Wf.Engine.Core.csproj" />
    <ProjectReference Include="..\Wf.Validation\Wf.Validation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\db\migrations\*.sql" LogicalName="Wf.Migrations.%(Filename)%(Extension)" />
    <Content Include="..\..\..\failure-categories\**\*.json" Link="failure-categories\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Syntax-only scaffold rewriting; ship the compiler libraries, never invoke a compiler on retained source. -->
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildBinPath)\Roslyn\bincore\Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildBinPath)\Roslyn\bincore\Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>
</Project>

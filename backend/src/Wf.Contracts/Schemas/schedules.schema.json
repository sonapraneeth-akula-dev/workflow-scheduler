{
  "type": "object",
  "properties": {
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "cron": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "interval": {
            "$comment": "Represents a System.TimeSpan value.",
            "type": "string",
            "pattern": "^(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.0{1,7})?$",
            "default": null
          },
          "versionPin": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 256,
            "description": "Exact SemVer or version UUID, comparison ranges joined by spaces (AND) or || (OR), or *, major.* and major.minor.* wildcards."
          },
          "overlap": {
            "enum": [
              "Skip",
              "Queue",
              "Concurrent"
            ],
            "default": "Skip"
          },
          "catchUp": {
            "enum": [
              "None",
              "Latest"
            ],
            "default": "Latest"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])\\S(?:[\\s\\S]*\\S)?$"
          },
          "variables": {
            "type": "object",
            "default": null
          }
        },
        "required": [
          "id",
          "timezone"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "cron"
            ],
            "not": {
              "required": [
                "interval"
              ]
            }
          },
          {
            "required": [
              "interval"
            ],
            "not": {
              "required": [
                "cron"
              ]
            }
          }
        ]
      }
    },
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "historyCards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])\\S(?:[\\s\\S]*\\S)?$"
          },
          "scheduleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "visible": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "id",
          "name",
          "scheduleIds"
        ],
        "additionalProperties": false
      },
      "default": null,
      "maxItems": 32,
      "description": "Ordered Service History cards. Omit for one all-runs workflow card; [] hides all cards. References use instance IDs; schedule-based manual runs remain in their schedule\u0027s card."
    },
    "defaults": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      },
      "default": null
    }
  },
  "required": [
    "instances"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kardia code-defined schedules"
}

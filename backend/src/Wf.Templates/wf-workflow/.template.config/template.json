{
  "$schema": "http://json.schemastore.org/template",
  "author": "Workflow Scheduler",
  "classifications": ["Workflow", "Test"],
  "identity": "Wf.Templates.Workflow.CSharp",
  "name": "Single-file workflow with offline tests",
  "shortName": "wf-workflow",
  "sourceName": "WorkflowSample",
  "defaultName": "SampleWorkflow",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "sdkVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "1.0.0",
      "description": "Matching Wf.Sdk and Wf.Sdk.Testing NuGet package version.",
      "replaces": "SDK_PACKAGE_VERSION"
    }
  }
}

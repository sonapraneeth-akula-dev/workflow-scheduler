    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.53.0",
    "monaco-editor": "0.57.0",
    "openapi-fetch": "^0.17.0",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "1.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "shadcn": "^4.21.4",
